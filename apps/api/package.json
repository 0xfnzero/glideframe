{
  "name": "@glideframe/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/ai/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@fastify/cors": "^11.2.0",
    "@glideframe/contracts": "0.1.0",
    "bullmq": "^5.58.5",
    "fastify": "^5.12.0",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.0.4"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlideFrame Desktop",
  "version": "0.1.0",
  "identifier": "com.openfnzero.glideframe.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3001",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GlideFrame Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/GlideFrame/**",
          "$VIDEO/GlideFrame/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "entitlements": "GlideFrame.entitlements"
    }
  }
}
